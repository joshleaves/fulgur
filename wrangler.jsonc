/**
 * Fulgur — Cloudflare-native Sparkle update server.
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "fulgur",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-22",
	"compatibility_flags": ["nodejs_compat"],

	"durable_objects": {
		"bindings": [
			{
				"class_name": "PublishCoordinator",
				"name": "PUBLISH_COORDINATOR"
			}
		]
	},
	"migrations": [
		{
			"new_sqlite_classes": ["PublishCoordinator"],
			"tag": "v1"
		}
	],

	"r2_buckets": [
		{
			"binding": "ARTIFACTS",
			"bucket_name": "fulgur-artifacts"
		}
	],

	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "fulgur-db",
			"database_id": "00000000-0000-0000-0000-000000000000"
		}
	],

	"observability": {
		"enabled": true
	},
	"upload_source_maps": true

	/**
	 * Publishing tokens are Worker secrets, one per application:
	 *   PUBLISH_TOKEN_FOO, PUBLISH_TOKEN_BAR, PUBLISH_TOKEN_FOO_STABLE, ...
	 * Set with: npx wrangler secret put PUBLISH_TOKEN_FOO
	 *
	 * Optional publish-timeout overrides (milliseconds):
	 *   PUBLISH_TIMEOUT, PUBLISH_TIMEOUT_FOO, ...
	 * Fallback chain: PUBLISH_TIMEOUT_<APP> -> PUBLISH_TIMEOUT -> 10000.
	 */
}
